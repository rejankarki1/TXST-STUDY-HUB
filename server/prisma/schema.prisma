generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  MODERATOR
  ADMIN
}

enum GroupPurpose {
  EXAM_PREP
  HOMEWORK
  WEEKLY_STUDYING
  PROJECT_WORK
  GENERAL_STUDY
}

enum MeetingStyle {
  IN_PERSON
  ONLINE
  FLEXIBLE
}

enum SessionMode {
  IN_PERSON
  ONLINE
}

enum SessionRsvpStatus {
  GOING
  MAYBE
  CANT
}

/// Membership rights inside one study group. The creator holds OWNER; everyone
/// who joins is a MEMBER. Kept deliberately small — anything finer grained is a
/// permissions model, not a membership role.
enum GroupRole {
  OWNER
  MEMBER
}

enum NotificationKind {
  SESSION
  MESSAGE
  REMINDER
  MEMBER
}

model User {
  id                    String             @id @default(uuid())
  email                 String             @unique
  name                  String?
  passwordHash          String
  role                  UserRole           @default(STUDENT)
  avatarUrl             String?
  bio                   String?
  major                 String?
  gradYear              Int?
  onboardingCompleted   Boolean            @default(false)
  selectedCourses       UserCourse[]
  createdStudyGroups    StudyGroup[]       @relation("StudyGroupCreator")
  studyGroupMemberships StudyGroupMember[]
  organizedSessions     StudySession[]     @relation("SessionOrganizer")
  sessionRsvps          SessionRsvp[]
  groupMessages         GroupMessage[]
  notifications         Notification[]     @relation("NotificationRecipient")
  actedNotifications    Notification[]     @relation("NotificationActor")
  refreshTokens         RefreshToken[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id           String             @id @default(uuid())
  code         String             @unique
  title        String
  description  String?
  departmentId String?
  department   Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  selectedBy   UserCourse[]
  studyGroups  StudyGroup[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model UserCourse {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model StudyGroup {
  id            String             @id @default(uuid())
  name          String
  description   String
  purpose       GroupPurpose       @default(GENERAL_STUDY)
  meetingStyle  MeetingStyle       @default(FLEXIBLE)
  maxMembers    Int
  courseId      String
  creatorId     String
  course        Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator       User               @relation("StudyGroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members       StudyGroupMember[]
  sessions      StudySession[]
  messages      GroupMessage[]
  notifications Notification[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([courseId])
  @@index([creatorId])
}

model StudyGroupMember {
  id           String     @id @default(uuid())
  studyGroupId String
  userId       String
  role         GroupRole  @default(MEMBER)
  joinedAt     DateTime   @default(now())
  lastReadAt   DateTime?
  studyGroup   StudyGroup @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([studyGroupId, userId])
  @@index([userId])
}

model StudySession {
  id             String         @id @default(uuid())
  groupId        String
  organizerId    String
  title          String
  description    String
  startsAt       DateTime
  endsAt         DateTime
  mode           SessionMode
  location       String
  locationDetail String?
  meetingLink    String?
  group          StudyGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  organizer      User           @relation("SessionOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  rsvps          SessionRsvp[]
  notifications  Notification[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([groupId])
  @@index([startsAt])
}

model SessionRsvp {
  id        String            @id @default(uuid())
  sessionId String
  userId    String
  status    SessionRsvpStatus
  session   StudySession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([sessionId, userId])
  @@index([userId])
}

model GroupMessage {
  id        String     @id @default(uuid())
  groupId   String
  authorId  String
  body      String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  /// Present so message editing can be added without another migration.
  updatedAt DateTime   @updatedAt

  @@index([groupId, createdAt])
}

/// Read state is per-notification via readAt; no aggregate unread counter is
/// stored, so "unread" is always derived from readAt IS NULL.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  kind      NotificationKind
  actorId   String?
  groupId   String?
  sessionId String?
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  group     StudyGroup?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  session   StudySession?    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
