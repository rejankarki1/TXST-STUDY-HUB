NODE_ENV=development
PORT=5050

# Comma-separated list of origins allowed to send credentialed requests.
CLIENT_URL=http://localhost:5173

DATABASE_URL="postgresql://txst_user:txst_password@localhost:5433/txst_study_hub?schema=public"
# Separate database used by the integration test suite. Never point this at dev data.
DATABASE_URL_TEST="postgresql://txst_user:txst_password@localhost:5434/txst_study_hub_test?schema=public"

# Must be at least 32 characters. Rotating it signs every existing session out.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_COOKIE_NAME=refreshToken

# true only when the client is served from a different site than the API.
CROSS_SITE_COOKIES=false

ALLOWED_EMAIL_DOMAIN=txstate.edu

# Password for the seeded demo accounts. Local development only.
DEMO_PASSWORD=DemoStudy!2026
